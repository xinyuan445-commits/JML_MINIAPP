<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlGroup PUBLIC "-
<!-- 岗位分工SQL -->
<sqlGroup namespace="device">
    <select id="queryList" parameterType="map">
        select
            a.id as id,
            a.name as name
        from
            jml_device a
        where
            a.enable = '1'
    </select>
</sqlGroup>