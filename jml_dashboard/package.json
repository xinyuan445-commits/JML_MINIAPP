    "antd": "^6.3.7",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "less": "^4.4.0",
    "typescript": "^6.0.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
