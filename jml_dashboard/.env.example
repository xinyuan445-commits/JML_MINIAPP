# 独立看板监听端口。未设置时使用 8890。
PORT=8890

# 监听所有网卡后，可同时使用 127.0.0.1 和部署电脑的局域网 IP 访问。
HOST=0.0.0.0

# 存在该证书时，8890 自动使用 HTTPS。相对路径按项目目录解析。
HTTPS_PFX_PATH=certs/board.jml.goldenchameleon.cn.pfx
# HTTPS_PFX_PASSPHRASE=仅在PFX设置密码时填写

# 默认启动项目内置只读 API，不再依赖管理后台 WebAPI。
DASHBOARD_API_MODE=embedded
DASHBOARD_API_PORT=8891
DASHBOARD_PYTHON=python
DASHBOARD_CACHE_SECONDS=10

# 仅在 DASHBOARD_API_MODE=external 时使用。
DASHBOARD_API_TARGET=http://127.0.0.1:5001

# 业务 MySQL（仅需只读权限）。
DB2_HOST=
DB2_USER=
DB2_PASSWORD=
DB2_NAME=
DASHBOARD_DB_POOL_SIZE=5

# U8 SQL Server（仅需只读权限）。
U8_DB_DRIVER=ODBC Driver 17 for SQL Server
U8_DB_SERVER=172.16.1.159
U8_DB_PORT=1433
U8_DB_NAME=UFDATA_008_2021
U8_DB_USER=
U8_DB_PASSWORD=
U8_DB_TIMEOUT=5
