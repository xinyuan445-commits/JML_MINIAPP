# Flask Session（原地址账号登录仍使用）
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
ADMIN_ALLOWED_ORIGINS=http://172.16.10.45:8886,https://production.jml.goldenchameleon.cn

# 生产管理数据库
DB2_HOST=
DB2_USER=
DB2_PASSWORD=
DB2_NAME=

# U8 数据源
U8_DB_DRIVER=ODBC Driver 17 for SQL Server
U8_DB_SERVER=
U8_DB_PORT=1433
U8_DB_NAME=
U8_DB_USER=
U8_DB_PASSWORD=
U8_DB_TIMEOUT=5
MOAPI_URL=https://api.jinmilong.cn/api/mo

# 金米龙统一平台 / Keycloak
OIDC_ENABLED=1
OIDC_ISSUER_URL=https://auth.jml.goldenchameleon.cn/realms/jml
OIDC_JWKS_URL=https://auth.jml.goldenchameleon.cn/realms/jml/protocol/openid-connect/certs
OIDC_AUDIENCE=jml-platform
OIDC_TOKEN_HEADER=X-Auth-Request-Access-Token
OIDC_VIEW_ROLES=production-view,production-admin,suite-admin
OIDC_WRITE_ROLES=production-admin,suite-admin
TRUSTED_PROXY_IPS=172.16.10.105
JML_PROXY_SECRET=
JML_PLATFORM_URL=https://production.jml.goldenchameleon.cn

# 报表邮件初始配置（仅初始化缺失记录；后续在管理后台维护）
SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=True
