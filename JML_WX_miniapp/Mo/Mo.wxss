.mo-page {
  min-height: 100vh;
  padding: 80rpx 48rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.head { font-size: 36rpx; font-weight: 800; margin-bottom: 8rpx; color: #111; }
.subhead { font-size: 26rpx; color: #8a97a6; margin-bottom: 24rpx; }

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -20rpx;
  margin-top: -20rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
}

.menu-card {
  width: calc(50% - 20rpx);
  margin-left: 20rpx;
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  position: relative;
  min-height: 95rpx;
  transition: transform .08s ease;
}
.menu-card:active { transform: scale(0.98); }

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  font-size: 34rpx;
  color: #c5c9d3;
}

.empty-tip {
  margin-top: 120rpx;
  text-align: center;
  font-size: 28rpx;
  color: #b0b8c1;
}
