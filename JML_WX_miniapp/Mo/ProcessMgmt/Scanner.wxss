.page {
  background: #f2f2f7;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  background: #f2f2f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  height: 72rpx;
  box-sizing: border-box;
}
.scan-btn {
  background: #007aff;
  border-radius: 12rpx;
  padding: 0 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.scan-txt {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ── 区块标题 ── */
.section-header {
  padding: 24rpx 32rpx 12rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.empty-wrap   { padding: 120rpx 0; }

/* ── 记录卡片 ── */
.card-hover { opacity: 0.7; }
.rec-card {
  margin: 0 0 12rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
}
.panel-empty {
  font-size: 26rpx;
  color: #c7c7cc;
  padding: 16rpx 0;
  text-align: center;
}

.rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.rec-mocode {
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
}


.rec-invname {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 4rpx;
}
.rec-process {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 14rpx;
}

.rec-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #f2f2f7;
}
.rec-time {
  font-size: 24rpx;
  color: #8e8e93;
}
.rec-qty-wrap {
  display: flex;
  align-items: baseline;
}
.rec-qty {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}
.rec-unit {
  font-size: 22rpx;
  color: #8e8e93;
}
