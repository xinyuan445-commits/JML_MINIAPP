<view class="page">
  <view class="card">

    <view class="form-row">
      <text class="form-label required">工序编码</text>
      <input class="form-input" placeholder="如 YT-01"
        value="{{form.process_code}}" data-field="process_code" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="form-label required">工序名称</text>
      <input class="form-input" placeholder="如 压贴"
        value="{{form.process_name}}" data-field="process_name" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="form-label">排序</text>
      <input class="form-input" type="number" placeholder="0"
        value="{{form.sort}}" data-field="sort" bindinput="onInput" />
    </view>

    <view class="form-row no-border">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="选填"
        value="{{form.description}}" data-field="description" bindinput="onInput" />
    </view>

  </view>

  <view class="submit-wrap">
    <t-button theme="primary" size="large" block bind:tap="onSubmit">提交</t-button>
  </view>
</view>
