body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.other{padding:10px;margin-top:10px}.other_tit{margin-bottom:10px;font-weight:600;color:#333;font-size:18px}.other_list{padding-top:5px}.other_list_itme{margin-bottom:10px;background-color:#fff;border-radius:var(--card-border-radius);padding:10px;display:flex;align-items:center;font-weight:600;color:#333;font-size:16px;min-height:45px}.other_list_itme label{margin-left:10px}.other_list_itme .link{margin-left:auto;color:#e0e0e0}.related{background:#F5F6F8;height:100vh;width:80vw;position:relative;display:flex;flex-direction:column}.related .addbox{margin-bottom:20px;width:calc(100% - 20px);text-align:center;display:flex;margin-top:auto}.related_tit{padding:25px 0 15px;background:#F5F6F8;font-size:16px;font-family:PingFang SC-Semibold,PingFang SC;font-weight:600;color:#333;text-align:center}.related .scrollHeight{height:100%}.related_list{line-height:1.6;max-height:calc(100% - 65px);overflow-y:hidden;position:relative}.related_list.iframe{height:calc(100% - 70px)}.related_list_itme{padding:10px;display:flex;align-items:center;background:#fff}.related_list_itme_tit{color:#333;font-size:15px;font-weight:600}.related_list_itme_left{font-weight:400;color:#999;font-size:12px}.related_list_itme_rigth{margin-left:auto}.related_list_itme_name{background:#849EB2;border-radius:4px;font-weight:600;color:#fff;font-size:14px;width:34px;height:34px;text-align:center;line-height:34px;margin-right:10px}
