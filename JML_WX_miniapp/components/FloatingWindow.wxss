body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.movable-area{height:100vh;width:100vw;left:0;bottom:40px;position:fixed;z-index:99;pointer-events:none}.movable-area .movable-view{width:50px;height:auto;right:0!important;left:auto;pointer-events:auto}.floatingWindow{max-width:70px}.floatingWindow .item .lable{font-size:12px;padding-bottom:5px;margin-top:3px}.floatingWindow .item{box-shadow:0 4px 10px rgba(153,153,153,.2);border:1px solid #DCDCDC;border-radius:50%;display:flex;width:50px;height:50px;flex-direction:column;align-content:center;justify-content:center;flex-flow:wrap;cursor:pointer;background:#fff;border-bottom:1px solid #E1E1E1;margin-bottom:20px}.floatingWindow .item.add_btn{background:#849EB2}.floatingWindow .item .lable{font-size:12px;padding-bottom:6px;transform:scale(.85)}
