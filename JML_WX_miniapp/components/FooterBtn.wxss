body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.footer{flex:0 0 auto;padding:0;margin-top:auto;position:fixed;left:0;bottom:0;width:100%;background:#fff;z-index:100}.footer .footer_btn{display:flex;width:100%;justify-content:space-evenly}.footer .footer_btn .btn{flex:1;padding:0;height:calc(50px + var(--ios-safe-bottom-low) / 4);height:calc(50px + var(--ios-safe-bottom-higt) / 4);font-size:16px;font-weight:600;cursor:pointer;background:#fff;border-radius:0;text-align:center;color:#849eb2;padding-bottom:calc(var(--ios-safe-bottom-low) / 4);padding-bottom:calc(var(--ios-safe-bottom-higt) / 4)}.footer .footer_btn .btn.confirm_btn{color:#fff;background:#849EB2}.footer .footer_btn .btn:last-child{margin-right:0}.footer .footer_tip{margin-top:10px;color:rgba(61,61,61,.5);font-size:12px;line-height:24px;text-align:center}.footer .footer_tip:before{content:"*";color:#ff0202;font-size:14px;margin-right:5px;display:inline-block;vertical-align:middle}
