body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.product_list{padding-bottom:20px}.product_list .addInfo{padding:10px 0;border-radius:var(--card-border-radius);line-height:1.4;position:relative;width:100%;height:calc(100vh - 240px);overflow-y:scroll;overscroll-behavior:contain;transform:1}.product_list .addInfo .card{padding:0 15px;background:none;position:relative;border-radius:var(--card-border-radius);line-height:1.4}.product_list .addInfo .card .info{font-size:14px;display:flex;flex-direction:row;color:#333;width:100%;align-items:center;line-height:1.5}.product_list .addInfo .card .info .left{color:var(--van-field-label-color)}.product_list .addInfo .card .info .left.required:before{margin-right:2px;color:var(--van-field-required-mark-color);content:"*"}.product_list .addInfo .card .info .rigth{margin-left:auto;flex:1}.product_list .addInfo .u-form-item,.product_list .addInfo .u-form-item__body__left__content__label,.product_list .addInfo .uni-input-input,.product_list .addInfo .uni-select,.product_list .addInfo .u-input__content__field-wrapper__field{font-size:12px!important}.product_list .addInfo .u-form-item__body{padding:5px 0}.product_list .addInfo .u-form-item__body__right{padding:4px}.product_info .card_info{max-width:100%;padding:10px;max-height:calc(100vh - 180px);overflow-y:scroll;overscroll-behavior:contain}.product_info .card_info .item{font-size:14px;margin:5px 0;display:flex;flex-direction:row;color:#333;width:100%;align-items:center;line-height:1.5}.product_info .card_info .item .left{color:#999;flex:1}.product_info .card_info .item .rigth{margin-left:auto;flex:1.5}.uni-table-td{font-size:12px;padding:4px 5px}.detail_add{color:#849eb2;text-align:center;margin-top:10px;width:100%;padding:10px;display:flex;align-items:center;justify-content:center}.uni-group .u-button,.uni-group button{font-size:12px;margin-top:10px;padding:12px 0}.uni-group .u-button:first-child,.uni-group button:first-child{margin-top:0}.card_head{display:flex;align-items:center;padding:15px 0 10px}.card_head_tit{display:flex;align-items:center;font-size:18px;font-weight:600;color:#333}.card_head_tit span{font-weight:700;font-size:16px;color:#000;margin-right:5px}
