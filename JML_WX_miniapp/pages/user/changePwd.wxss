body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.page{background-color:#f4f7fa;padding:40rpx 56rpx 0rpx;min-height:100%}.page .head{padding:100rpx 0}.page .head .title{font-size:60rpx;font-weight:900;color:#333;position:relative;z-index:9999}.page .head .logo{position:absolute;right:-50rpx;width:400rpx;top:50rpx;z-index:1}.page .mian{position:relative;border-radius:30rpx;z-index:9999;text-align:center;flex:1;display:flex;flex-direction:column}.page .mian .itme{margin:30rpx auto;text-align:left;width:100%}.page .mian .itme .lable{font-size:32rpx;font-family:PingFang SC-Regular,PingFang SC;font-weight:400;color:#232a51;line-height:14px}.page .mian .itme .inp{margin-top:20rpx}.page .mian .itme .inp .inp_txt{color:#232a51;font-size:14px;background:#fff;border-radius:10px;padding:30rpx;height:auto}.page .mian .itme .check{color:#101010}.page .mian .btn_login{width:100%;height:54px;background:rgba(132,158,178,.3);box-shadow:0 6px 10px rgba(132,158,178,.1);border-radius:10px;margin:10% auto 0;line-height:54px;font-size:16px;font-family:PingFang SC-Semibold,PingFang SC;font-weight:600;color:#fff;text-align:center}.page .mian .btn_login.isOK{background:#849EB2;box-shadow:0 16px 20px rgba(132,158,178,.35)}.page .resetpwd_btn{font-family:PingFang SC,PingFang SC;font-weight:400;color:#849eb2;line-height:20px;margin-top:70rpx}
