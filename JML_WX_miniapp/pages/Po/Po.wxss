.po-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  --td-search-bg-color: #fff;
}

/* 顶部吸顶区域 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  padding: 10rpx 0 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 第一行：搜索 + 状态 */
.row-1 {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
}

.search-container {
  flex: 1; /* 占据剩余空间 */
}

.status-dropdown {
  width: 200rpx; /* 固定宽度，确保能放下“全部状态” */
  flex-shrink: 0;
}

/* 第二行：公司 + 日期 */
.row-2 {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-top: 16rpx;
  gap: 16rpx;
}

.company-dropdown {
  width: 180rpx;
  flex-shrink: 0;
}

/* 日期筛选区 */
.date-filter {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end; /* 靠右对齐 */
  gap: 12rpx;
}

.date-item {
  background: #f3f3f3;
  padding: 10rpx 20rpx; /* 减小内边距，适应高度 */
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  min-width: 160rpx; /* 适当减小宽度 */
  text-align: center;
  height: 64rpx; /* 与 dropdown 高度对齐 */
  line-height: 64rpx;
  box-sizing: border-box;
}

.date-item.placeholder {
  color: #999;
}

.date-separator {
  color: #ccc;
  font-weight: bold;
}

/* 列表区域 */
.list-wrap {
  height: calc(100vh - 240rpx); /* 重新计算高度 */
  box-sizing: border-box;
}

.list-content {
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.company-tag {
  font-size: 20rpx !important;
}

.order-no {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.label {
  color: #999;
}

.value {
  color: #333;
}

.value.price {
  color: #d54941;
  font-weight: bold;
  font-size: 28rpx;
}

/* 底部加载状态 */
.loading-footer {
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more {
  font-size: 24rpx;
  color: #ccc;
}
