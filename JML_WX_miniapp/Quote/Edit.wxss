.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 32rpx 0 80rpx;
  box-sizing: border-box;
}

/* 材料明细表 */
.mat-head,
.mat-row {
  display: flex;
  align-items: center;
  padding: 14rpx 32rpx;
  position: relative;
}

.mat-head {
  background: #F7F7FA;
}

.mat-row::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.mat-head .mat-type,
.mat-head .mat-code,
.mat-head .mat-price,
.mat-head .mat-logistics,
.mat-head .mat-use,
.mat-head .mat-del {
  font-size: 24rpx;
  color: #8E8E93;
}

.mat-type { width: 150rpx; flex-shrink: 0; }
.mat-code { flex: 1; min-width: 0; }
.mat-price { width: 110rpx; text-align: right; flex-shrink: 0; }
.mat-logistics { width: 100rpx; text-align: right; flex-shrink: 0; }
.mat-use { width: 82rpx; flex-shrink: 0; text-align: center; }
.mat-switch { transform: scale(0.72); }
.mat-del { width: 44rpx; text-align: center; flex-shrink: 0; }

.mat-type-cell {
  font-size: 26rpx;
  color: #007AFF;
}

.mat-input {
  font-size: 26rpx;
  color: #1C1C1E;
}

.mat-del {
  color: #FF3B30;
  font-size: 26rpx;
}

.mat-disabled {
  color: #C7C7CC;
}

.mat-add {
  text-align: center;
  color: #007AFF;
  font-size: 28rpx;
  padding: 24rpx;
}

/* 注意事项入口 */
.tips-entry {
  display: inline-flex;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 8rpx 4rpx;
}

.tips-entry-hover { opacity: 0.6; }

.tips-badge {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #FF9500;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #FF9500;
}

/* 可点击的标题（点击复制存货编码） */
.label-tap {
  color: #007AFF;
}

/* 分组卡片 */
.group {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx;
  overflow: hidden;
}

/* 每行 */
.row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 32rpx;
  position: relative;
}

/* 行底细分隔线（左侧内缩，iOS 风格）；picker 嵌套会断开相邻关系，故按行画 */
.row::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.row.last::after {
  display: none;
}

.row-hover {
  background: #F2F2F7;
}

.label {
  width: 200rpx;
  font-size: 32rpx;
  color: #1C1C1E;
}

.input {
  flex: 1;
  font-size: 32rpx;
  color: #1C1C1E;
  text-align: right;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #1C1C1E;
}

.ph {
  color: #C7C7CC;
}

/* iOS 右侧箭头 */
.chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid #C7C7CC;
  border-right: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
}

/* 保存按钮 */
.save-wrap {
  margin: 64rpx 32rpx 0;
}

.save-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.save-btn-hover {
  opacity: 0.85;
}

.save-btn-disabled {
  opacity: 0.55;
}

/* 客户联想建议项 */
.cust-sug {
  padding: 22rpx 32rpx;
  background: #F7F7FA;
  position: relative;
}

.cust-sug::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.cust-sug-text {
  font-size: 30rpx;
  color: #007AFF;
}

/* 存货编码查询按钮 */
.search-btn {
  margin-left: 16rpx;
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: #007AFF;
  background: #EAF3FF;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.search-btn-hover {
  opacity: 0.7;
}

/* 底部选择弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #1C1C1E;
  border-bottom: 1px solid #E5E5EA;
}

.sheet-close {
  color: #007AFF;
  font-size: 28rpx;
}

.sheet-list {
  flex: 1;
  max-height: 60vh;
}

.sheet-item {
  padding: 24rpx 32rpx;
  position: relative;
}

.sheet-item::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.sheet-code {
  font-size: 30rpx;
  color: #1C1C1E;
}

.sheet-name {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

/* 分组标题 */
.section-title {
  margin: 40rpx 44rpx 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

/* 完整路线 */
.route-card {
  display: flex;
  align-items: flex-start;
  margin: 0 32rpx;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.route-text {
  flex: 1;
  color: #3A3A3C;
  font-size: 28rpx;
  line-height: 1.75;
}

/* 可展开成本汇总 */
.cost-card {
  margin: 0 32rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.cost-block {
  position: relative;
}

.cost-block::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.cost-block:last-child::after {
  display: none;
}

.cost-main {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
}

.cost-name {
  flex: 1;
  color: #1C1C1E;
  font-size: 30rpx;
}

.cost-amount {
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 600;
}

.cost-detail {
  padding: 8rpx 32rpx 20rpx 52rpx;
  background: #F7F7FA;
}

.cost-detail-row {
  display: flex;
  align-items: flex-start;
  padding: 13rpx 0;
}

.cost-detail-name {
  flex: 1;
  padding-right: 20rpx;
  color: #636366;
  font-size: 26rpx;
  line-height: 1.45;
}

.cost-detail-amount {
  flex-shrink: 0;
  color: #3A3A3C;
  font-size: 26rpx;
}

.cost-detail-empty {
  padding: 12rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

.label.strong,
.value.strong {
  font-weight: 600;
}

/* 报价参数单位 */
.unit {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #8E8E93;
  flex-shrink: 0;
}

/* 未配置工序提醒 */
.warn {
  margin: 0 32rpx 16rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #FF9500;
  background: #FFF4E5;
  border-radius: 16rpx;
}

/* 成本类别折叠箭头（默认朝下，展开朝上） */
.chevron-down {
  width: 14rpx;
  height: 14rpx;
  margin-left: 16rpx;
  border-right: 3rpx solid #C7C7CC;
  border-bottom: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
  transition: transform 0.2s;
}

.chevron-down.up {
  transform: rotate(-135deg);
}

/* 折叠出来的构成明细 */
.sub {
  background: #F7F7FA;
  padding: 8rpx 0;
}

.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 16rpx 56rpx;
}

.sub-name {
  font-size: 28rpx;
  color: #636366;
}

.sub-amount {
  font-size: 28rpx;
  color: #636366;
}

.sub-empty {
  font-size: 28rpx;
  color: #C7C7CC;
}

/* 报价结果卡片 */
.result-card {
  margin: 32rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
}

.result-cap {
  font-size: 28rpx;
  color: #8E8E93;
}

.result-price {
  margin-top: 16rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #007AFF;
}

.result-hint {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #C7C7CC;
}

/* 直营/经销商两套报价 */
.quote-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 20rpx;
}

.quote-tag {
  font-size: 26rpx;
  color: #8E8E93;
  margin-right: 16rpx;
}

.quote-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #007AFF;
}

.quote-excl {
  font-size: 24rpx;
  color: #8E8E93;
  margin-left: 16rpx;
}

.result-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

/* 计算说明折叠 */
.formula-toggle {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 8rpx 4rpx;
}

.formula-toggle-text {
  font-size: 26rpx;
  color: #007AFF;
}

.formula-box {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #F7F7FA;
  border-radius: 16rpx;
  text-align: left;
}

.formula-line {
  padding: 8rpx 0;
  font-size: 27rpx;
  color: #3A3A3C;
}

.formula-tip {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #E5E5EA;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8E8E93;
}
