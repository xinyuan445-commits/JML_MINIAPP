.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 32rpx 0 80rpx;
  box-sizing: border-box;
}

.group {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 32rpx;
  position: relative;
}

.row::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1px;
  background: #E5E5EA;
}

.row.last::after { display: none; }
.row-hover { background: #F2F2F7; }

.label {
  width: 200rpx;
  font-size: 32rpx;
  color: #1C1C1E;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #1C1C1E;
}

.label.strong,
.value.strong { font-weight: 600; }

.value.link { color: #007AFF; font-size: 28rpx; }

/* 右侧箭头 */
.chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid #C7C7CC;
  border-right: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.section-title {
  margin: 40rpx 44rpx 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

.route-card {
  margin: 0 32rpx;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #3A3A3C;
  font-size: 28rpx;
  line-height: 1.75;
}

/* 折叠箭头 */
.chevron-down {
  width: 14rpx;
  height: 14rpx;
  margin-left: 16rpx;
  border-right: 3rpx solid #C7C7CC;
  border-bottom: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
  transition: transform 0.2s;
  flex-shrink: 0;
}

.chevron-down.up { transform: rotate(-135deg); }

/* 构成明细 */
.sub {
  background: #F7F7FA;
  padding: 8rpx 0;
}

.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 16rpx 56rpx;
}

.sub-name { font-size: 28rpx; color: #636366; }
.sub-amount { font-size: 28rpx; color: #636366; }
.sub-empty { font-size: 28rpx; color: #C7C7CC; }

/* 结果卡片 */
.result-card {
  margin: 32rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
}

.result-cap { font-size: 28rpx; color: #8E8E93; }

.result-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #007AFF;
}

.quote-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 20rpx;
}

.quote-tag {
  margin-right: 16rpx;
  color: #8E8E93;
  font-size: 26rpx;
}

.quote-excl {
  margin-left: 16rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.result-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

/* 计算说明 */
.formula-toggle {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 8rpx 4rpx;
}

.formula-toggle-text { font-size: 26rpx; color: #007AFF; }

.formula-box {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #F7F7FA;
  border-radius: 16rpx;
  text-align: left;
}

.formula-line {
  padding: 8rpx 0;
  font-size: 27rpx;
  color: #3A3A3C;
}

.formula-tip {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #E5E5EA;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8E8E93;
}

/* 悬浮操作：展开内容 / 收缩边缘箭头（对齐 t-fab 官方示例） */
.fab-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  width: 96rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow:
    0 10rpx 10rpx -6rpx rgba(0, 0, 0, 0.1),
    0 16rpx 20rpx 2rpx rgba(0, 0, 0, 0.06),
    0 6rpx 28rpx 4rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.fab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #007AFF;
}

.fab-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #1C1C1E;
}

.fab-symbol {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx 0 0 32rpx;
  background: #FFFFFF;
  color: #8E8E93;
  border: 1px solid #DCDCDC;
  border-right: 0;
  box-shadow:
    0 10rpx 10rpx -6rpx rgba(0, 0, 0, 0.1),
    0 16rpx 20rpx 2rpx rgba(0, 0, 0, 0.06),
    0 6rpx 28rpx 4rpx rgba(0, 0, 0, 0.05);
}
