.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 0 120rpx;
  box-sizing: border-box;
}

/* 筛选区 */
.filter {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
}

/* 搜索栏 */
.search {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F2F2F7;
  border-radius: 36rpx;
}

.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #C7C7CC;
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: #C7C7CC;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1C1C1E;
}

.ph { color: #C7C7CC; }

/* 筛选 chip 横排 */
.chips {
  margin-top: 18rpx;
  white-space: nowrap;
}

.chip-pick {
  display: inline-block;
  margin-right: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 24rpx;
  background: #F2F2F7;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #636366;
}

.chip.on {
  background: #EAF3FF;
  color: #007AFF;
}

.chip.reset {
  background: #FFECEC;
  color: #FF3B30;
}

.chip-hover { opacity: 0.7; }

.chip-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  opacity: 0.55;
}

/* 列表 */
.list {
  margin: 0 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(28, 28, 30, 0.04);
}

.card-hover { background: #F7F7FA; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quote-no {
  color: #1C1C1E;
  font-size: 30rpx;
  font-weight: 600;
}

.customer {
  margin-top: 22rpx;
  color: #1C1C1E;
  font-size: 36rpx;
  font-weight: 700;
}

.category {
  margin-top: 8rpx;
  color: #636366;
  font-size: 27rpx;
  line-height: 1.45;
}

.price-panel {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
  padding: 22rpx 12rpx;
  border-radius: 18rpx;
  background: #F7F8FA;
}

.price-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.price-label {
  color: #8E8E93;
  font-size: 23rpx;
}

.price {
  margin-top: 7rpx;
  color: #007AFF;
  font-size: 35rpx;
  font-weight: 700;
}

.price-divider {
  width: 1px;
  margin: 2rpx 12rpx;
  background: #E5E5EA;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid #F0F0F2;
}

.staff {
  font-size: 24rpx;
  color: #8E8E93;
}

.date {
  font-size: 24rpx;
  color: #C7C7CC;
}

/* 空态 */
.empty {
  padding-top: 200rpx;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #C7C7CC;
}

/* 新增悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  text-align: center;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 64rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.4);
  z-index: 50;
}

.fab-hover { opacity: 0.85; }
