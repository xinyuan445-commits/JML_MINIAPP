/* 旧版样式完整保留在 Detailed.legacy.wxss。 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f7fa;
}

.hero,
.card {
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(16, 24, 40, 0.05);
}

.hero {
  padding: 30rpx;
  background: linear-gradient(135deg, #849eb2, #607d94);
  color: #fff;
}

.doc-no {
  font-size: 34rpx;
  font-weight: 750;
}

.factory {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.device {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
}

.card {
  padding: 28rpx;
}

.card-title {
  margin-bottom: 24rpx;
  color: #344054;
  font-size: 28rpx;
  font-weight: 650;
}

.reading-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.reading-grid > view {
  padding: 24rpx 14rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.metric-label,
.metric-value {
  display: block;
}

.metric-label {
  color: #98a2b3;
  font-size: 23rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #344054;
  font-size: 29rpx;
  font-weight: 700;
}

.usage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #eef4ff;
  color: #475467;
  font-size: 27rpx;
}

.usage-value {
  color: #1677ff;
  font-size: 32rpx;
  font-weight: 750;
}

.photo {
  width: 100%;
  height: 420rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.no-photo,
.status {
  padding: 80rpx 0;
  color: #98a2b3;
  font-size: 26rpx;
  text-align: center;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
  color: #344054;
  font-size: 26rpx;
  text-align: right;
}

.info-row:last-child {
  border-bottom: 0;
}

.label {
  flex-shrink: 0;
  color: #98a2b3;
  text-align: left;
}
