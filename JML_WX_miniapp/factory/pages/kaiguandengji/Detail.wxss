.page { padding: 20rpx; background: #f6f7fb; min-height: 100vh; }

/* 单号 */
.docno {
  font-weight: 800; font-size: 34rpx; color: #101828;
  margin-bottom: 20rpx; padding: 8rpx 6rpx;
}

/* 卡片 */
.card {
  background: #fff; border-radius: 16rpx; padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(16,24,40,.06); margin-bottom: 18rpx;
}

.row { display: flex; align-items: center; gap: 16rpx; }
.flex1 { flex: 1; }
.cell { display: flex; gap: 12rpx; align-items: center; }
.label { color: #667085; }
.val { font-weight: 600; color: #111827; }

/* 状态徽章，沿用 Edit 风格 */
.badge{
  padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  background: #ecfdf3; color: #027a48;
}
.badge-off { background: #fef3f2; color: #b42318; }
.badge-warn{ background: #fff1f3; color: #c11574; }

/* 图片盒子（展示） */
.photo-box {
  width: 100%; height: 360rpx; border-radius: 16rpx;
  background: #fafbfe;
  border: 2rpx dashed #d0d5dd;
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}
.photo { width: 100%; height: 100%; }
.placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; }
.plus { font-size: 64rpx; line-height: 1; color: #98a2b3; }
.tip { margin-top: 8rpx; color: #98a2b3; font-size: 24rpx; }

/* 详情 KV 行 */
.kv { display:flex; justify-content:space-between; align-items:flex-start; margin-top: 10rpx; }
.k { color:#667085; }
.v { color:#344054; max-width:70%; text-align:right; }
