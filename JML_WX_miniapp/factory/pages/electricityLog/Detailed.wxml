<view class="{{['page', 'pd100', virtualHostClass]}}" style="{{virtualHostStyle}}">
  <view class="card_info">
    <view class="card">
      <view class="card_head">
        <view class="card_head_tit">{{a}}</view>
      </view>
      <u-divider u-i="54137dcd-0" bind:__l="__l"></u-divider>
      <view class="card_main">
        <view class="item">
          <view class="left">具体位置/电表类型</view>
          <view class="rigth">{{b}} - {{c}}</view>
        </view>
        <view class="item">
          <view class="left">上一次用电示数</view>
          <view class="rigth">{{d}}</view>
        </view>
        <view class="item">
          <view class="left">今日用电示数</view>
          <view class="rigth">{{e}}</view>
        </view>
        <view class="item">
          <view class="left">今日示数照片</view>
          <view wx:if="{{f}}" class="rigth">
            <image wx:for="{{g}}" wx:for-item="item" wx:key="a" mode="widthFix" src="{{item.b}}" />
          </view>
        </view>
        <view class="item">
          <view class="left">本次用电耗用量</view>
          <view class="rigth">{{h}} （单位：度）</view>
        </view>
        <view class="item">
          <view class="left">备注</view>
          <view class="rigth">{{i}}</view>
        </view>
      </view>
      <view class="card_head_tit2 mt15"> 系统信息 </view>
      <u-divider u-i="54137dcd-1" bind:__l="__l"></u-divider>
      <view class="card_main">
        <view class="item">
          <view class="left">创建时间</view>
          <view class="rigth">{{j}}</view>
        </view>
        <view class="item">
          <view class="left">创建员工</view>
          <view class="rigth">{{k}}</view>
        </view>
        <view class="item">
          <view class="left">修改时间</view>
          <view class="rigth">{{l}}</view>
        </view>
        <view class="item">
          <view class="left">修改员工</view>
          <view class="rigth">{{m}}</view>
        </view>
      </view>
    </view>
  </view>
  <footer-btn wx:if="{{n}}" bindonconfirm="{{o}}" u-i="54137dcd-2" bind:__l="__l" u-p="{{p}}"></footer-btn>
  <floating-window u-i="54137dcd-3" bind:__l="__l"></floating-window>
</view>