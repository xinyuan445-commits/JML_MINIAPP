body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.uni-table-td{display:table-cell;padding:8px 10px;font-size:14px;border-bottom:1px #EBEEF5 solid;font-weight:400;color:#606266;line-height:1.2;box-sizing:border-box;vertical-align:middle}.uni-table-td.table--fixed{position:sticky;z-index:3;left:0;background:#fff}.uni-table-td.table--fixed:after{content:" ";position:absolute;right:-15rpx;top:0;width:15rpx;height:100%;background:linear-gradient(270deg,rgba(255,255,255,0) 0%,rgba(0,0,0,.04) 100%)}.uni-table-td.operate{position:sticky;z-index:3;right:0;background:#fff}.uni-table-td.operate:after{content:" ";position:absolute;left:-15rpx;top:0;width:15rpx;height:100%;background:linear-gradient(270deg,rgba(255,255,255,0) 0%,rgba(0,0,0,.04) 100%)}.table--border{border-right:1px #EBEEF5 solid}
