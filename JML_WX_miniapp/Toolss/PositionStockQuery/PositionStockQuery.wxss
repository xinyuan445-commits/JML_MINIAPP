.page {
  padding: 24rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.query-card {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 28rpx;
}

.btn {
  background: #1677ff;
  color: #fff;
  font-size: 28rpx;
}

.list .item {
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: bold;
}

.qty {
  color: #1677ff;
}

.sub {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

.load-more {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}
.page {
  height: 100vh;
  background: #f7f8fa;
}

.query-card.fixed {
  background: #fff;
  padding: 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.list-scroll {
  height: calc(100vh - 160rpx);
  padding: 0 24rpx;
}

.loading,
.no-more {
  text-align: center;
  color: #999;
  padding: 20rpx 0;
}
