.container {
  padding: 40rpx;
}

.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.scan-icon {
  width: 140rpx;
  height: 140rpx;
}

.scan-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.result {
  background: #f7f8fa;
  padding: 30rpx;
  border-radius: 12rpx;
}

.row {
  display: flex;
  align-items: flex-start; /* 名称多行时顶部对齐 */
  margin-bottom: 16rpx;
}

.label {
  width: 160rpx;      /* 👈 关键：统一标签宽度 */
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;     /* 防止被压缩 */
}


.value {
  flex: 1;
  font-size: 28rpx;
  color: #000;
  line-height: 40rpx;
  word-break: break-all;   /* 超长型号强制换行 */
}

.stock {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.stock-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.stock-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #eee;
  font-size: 28rpx;
}

.stock-row.header {
  font-weight: 600;
  color: #666;
  border-bottom: 2px solid #ddd;
}
/* 批号与标签一致的库存行高亮（淡蓝色） */
.row-highlight {
  background-color: #e6f4ff;
}
.row-highlight {
  background-color: #e6f4ff;
  border-left: 6rpx solid #1890ff;
}
