.page{padding:12px;background:#f7f8fa;min-height:100vh;box-sizing:border-box}
.row{display:flex;align-items:center;margin-bottom:10px;gap:8px}
.label{width:90px;color:#666;font-size:14px}
.ipt{flex:1;border:1px solid #e5e6eb;border-radius:8px;padding:8px 10px;background:#fff}
.btns{display:flex;gap:10px;margin-top:16px}
.picker{flex:1}
.picker-inner{width:100%}
