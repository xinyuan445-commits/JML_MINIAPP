.tools-page{
  min-height:100vh;
  /* 顶部更远一点、左右更宽一点；底部安全区同步到 48rpx */
  padding:80rpx 48rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom:calc(48rpx + env(safe-area-inset-bottom));
  background:#f7f8fa;
  box-sizing:border-box;
}

.head{font-size:36rpx;font-weight:800;margin-bottom:8rpx;color:#111}
.subhead{font-size:26rpx;color:#8a97a6;margin-bottom:24rpx}

/* 外层滚动，避免长列表被底部安全区挡住 */
.tool-wrap{
  max-height: calc(100vh - 140rpx); /* 头部区域高度的预估，按需微调 */
}

/* —— 栅格：用负 margin + item margin 代替 gap，iOS 更稳 —— */
.tool-grid{
  display:flex;
  flex-wrap:wrap;
  margin-left:-20rpx;   /* 与 item 的 margin 对应 */
  margin-top:-20rpx;
  padding:6rpx 0;
  box-sizing:border-box;
}

/* 卡片：两列 */
.tool-card{
  width: calc(50% - 20rpx);
  margin-left:20rpx;    /* 代替 gap 的列距 */
  margin-top:20rpx;     /* 代替 gap 的行距 */
  background:#fff;
  border-radius:16rpx;
  padding:24rpx 20rpx;
  box-shadow:0 6rpx 16rpx rgba(0,0,0,0.06);
  display:flex;
  align-items:center;
  position:relative;
  min-height:95rpx;
  transition:transform .08s ease;
}
.tool-card:active{ transform: scale(0.98); }

/* 左侧图标 */
.icon{
  width:56rpx;
  height:56rpx;
  margin-right:14rpx;
  flex-shrink:0;
  opacity:.95;
}

/* 名称占满中间 */
.title{
  flex:1;
  font-size:28rpx;
  color:#333;
  font-weight:600;
  line-height:1.4;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

/* 右侧小箭头 */
.arrow{
  position:absolute;
  right:18rpx;
  top:18rpx;
  font-size:34rpx;
  color:#c5c9d3;
}

/* —— 弹层 —— */
.overlay{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;z-index:999}
.dialog{width:600rpx;background:#fff;border-radius:20rpx;padding:32rpx 28rpx;box-shadow:0 10rpx 24rpx rgba(0,0,0,0.12)}
.dialog-title{font-size:32rpx;font-weight:700;margin-bottom:16rpx;color:#111}
.dialog-input{border:1rpx solid #e5e7eb;border-radius:12rpx;padding:18rpx 20rpx;font-size:28rpx;margin-bottom:16rpx}
.btn{margin-top:12rpx;border-radius:12rpx;background:#eef2f7;color:#334155}
.btn.primary{background:#3b82f6;color:#fff}
.btn.ghost{background:#fff;border:1rpx solid #cfd6df;color:#3b82f6}
.result{margin-top:16rpx;padding:16rpx;border-radius:12rpx;background:#f8fafc}
.result-label{font-size:24rpx;color:#64748b}
.result-text{font-size:28rpx;color:#0f172a;word-break:break-all}
