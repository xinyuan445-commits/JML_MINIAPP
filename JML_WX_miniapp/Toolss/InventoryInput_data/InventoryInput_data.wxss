/* 页面整体布局 */
.container {
  padding: 20rpx;
}

/* ============================== */
/*        查询区域样式            */
/* ============================== */

.search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

/* 日期框与货位框保持统一高度 */
.picker-box,
.pos-input {
  height: 80rpx;
  line-height: 80rpx;   /* 文字垂直居中 */
  padding: 0 20rpx;
  border: 1px solid #ccc;
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

/* 日期选择器最小宽度，避免太窄 */
.picker-box {
  min-width: 220rpx;
  text-align: center;
}

/* 货位框占更多空间 */
.pos-input {
  flex: 1;
}

/* 查询按钮 */
.search-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  background-color: #007aff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ============================== */
/*         卡片展示区域           */
/* ============================== */

.card {
  background: #ffffff;
  margin-bottom: 30rpx;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f1f1f1;
}

/* 卡片标题区域 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.invcode {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.4;
}

/* 数量徽章 */
.qty-badge {
  background: linear-gradient(135deg, #4A90E2, #007AFF);
  padding: 10rpx 26rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0,122,255,0.25);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #eaeaea;
  margin: 18rpx 0;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.label {
  color: #888;
  width: 120rpx;
}

.value {
  color: #333;
  font-weight: 500;
}

/* ============================== */
/*         状态提示文本           */
/* ============================== */

.loading,
.empty,
.nomore {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
}
.right-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.delete-btn {
  font-size: 32rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: #ffecec;
}

/* ==================== 新增历史记录样式 ==================== */

.empty {
  text-align: center;
  color: #999;
  padding: 20rpx 0;
}

.card {
  background: #fff;
  padding: 28rpx;
  border-radius: 16rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.invcode {
  font-size: 32rpx;
  font-weight: bold;
}

.qty-badge {
  background: #007aff;
  color: #fff;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.divider {
  height: 1rpx;
  background: #e9e9e9;
  margin: 12rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.label2 {
  color: #666;
}

.value {
  color: #333;
}
