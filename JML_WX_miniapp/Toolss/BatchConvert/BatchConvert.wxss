.page{min-height:100vh;padding:32rpx;background:#f7f8fa;box-sizing:border-box}
.head{font-size:36rpx;font-weight:800;margin-bottom:8rpx;color:#111}
.subhead{font-size:26rpx;color:#8a97a6;margin-bottom:24rpx}
.mode-tabs{display:flex;background:#fff;border-radius:16rpx;overflow:hidden;margin-bottom:20rpx}
.tab{flex:1;text-align:center;padding:20rpx 0;color:#64748b}
.tab.active{background:#3b82f6;color:#fff}
.input{border:1rpx solid #e5e7eb;border-radius:12rpx;padding:18rpx 20rpx;font-size:28rpx;background:#fff;margin-bottom:16rpx}
.btn{margin-top:12rpx;border-radius:12rpx;background:#eef2f7;color:#334155}
.btn.primary{background:#3b82f6;color:#fff}
.btn.ghost{background:#fff;border:1rpx solid #cfd6df;color:#3b82f6}
.result{margin-top:16rpx;padding:16rpx;border-radius:12rpx;background:#fff}
.result-label{font-size:24rpx;color:#64748b}
.result-text{font-size:28rpx;color:#0f172a;word-break:break-all}
.tips{margin-top:28rpx;color:#94a3b8;font-size:24rpx;display:flex;flex-direction:column;gap:6rpx}