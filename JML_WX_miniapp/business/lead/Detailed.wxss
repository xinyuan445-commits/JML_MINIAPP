body,html,page,#app{width:100%;height:100%;font-family:PingFang SC,Microsoft YaHei,\5fae\8f6f\96c5\9ed1,Arial,sans-serif}body{-webkit-text-size-adjust:100%!important;text-size-adjust:100%!important;-moz-text-size-adjust:100%!important;font-size:12px}.page{background:#F5F6F8;min-height:100%;padding:0;--van-cell-group-inset-padding:0;--card-border-radius:5px;--card-padding:0 10px;--van-divider-line-height:1px;--van-divider-margin:0;--el-table-border:0}.page .card_info{max-width:100%;padding:10px}.page .card_info .van-swipe-cell{background:#669DF0;border-radius:var(--card-border-radius)}.page .card_info .card{background:#fff;padding:var(--card-padding);position:relative;border-radius:var(--card-border-radius);line-height:1.4}.page .card_info .card .card_head{display:flex;align-items:center;padding:15px 0 10px}.page .card_info .card .card_head_tit{font-size:18px;font-weight:600;color:#333}.page .card_info .card .card_head_tit label{font-weight:700;font-size:16px;color:#000;margin-right:5px}.page .card_info .card .card_head_tit .txt1{font-size:16px}.page .card_info .card .card_head_tit .txt2{font-size:12px;color:#999}.page .card_info .card .card_head_tit2{display:flex;align-items:center;font-size:16px;font-weight:600;color:#333;margin:15px 0 10px}.page .card_info .card .card_head_name{background:#849EB2;border-radius:4px;font-weight:600;color:#fff;font-size:14px;width:34px;height:34px;text-align:center;line-height:34px;margin-right:10px}.page .card_info .card .card_head .head_status{position:absolute;right:0;top:0}.page .card_info .card .card_head .head_status .van-icon__image{height:auto}.page .card_info .card .item{font-size:14px;margin:5px 0;display:flex;flex-direction:row;color:#333;width:100%;align-items:center;line-height:1.5}.page .card_info .card .item .left{color:#999;flex:1;word-wrap:break-word;overflow:auto}.page .card_info .card .item .rigth{margin-left:auto;flex:1.5;word-wrap:break-word;overflow:auto}.page .card_info .card .item .rigth.inlineflex{display:inline-flex}.page .card_info .card .item .rigth image{width:100%}.page .card_info .card .item .rigth .tag_list .tag{display:inline-flex;align-items:center;margin-right:10px;line-height:16px}.page .card_info .card .item .rigth .tag_list .tag_icon{width:16px;height:16px;color:#fff;background:#849EB2;border-radius:4px;margin-right:2px;display:flex;align-items:center;justify-content:center}.page .card_info .card .item .link{color:#849eb2;border-bottom:1px solid #849EB2;padding-bottom:2px}.page .card_info .card .card_main{padding:10px 0}.page .card_info .card .card_main .tel{display:inline-flex;align-items:center}.page .card_info .card .card_main .tel span{font-weight:700;font-size:16px;color:#000;margin-right:5px}.page .card_info .card .card_footer{padding:5px 0;position:relative}.page .card_info .card .card_footer .link{position:absolute;color:#849eb2;right:10px;top:50%;transform:translateY(-50%);-webkit-transform:translate(0%,-50%);-moz-transform:translate(0%,-50%)}.page .card_info .card_right{display:flex;align-items:center;justify-items:center;height:100%;padding:0 30px}.page .card_info .card_right .card_right_btn{text-align:center;font-size:12px;color:#fff}.page .card_info .card_right .card_right_btn .txt{margin-top:5px}.other{padding:10px;margin-top:10px}.other_tit{margin-bottom:10px;font-weight:600;color:#333;font-size:18px}.other_list{padding-top:5px}.other_list_itme{margin-bottom:10px;background-color:#fff;border-radius:var(--card-border-radius);padding:10px;display:flex;align-items:center;font-weight:600;color:#333;font-size:16px;min-height:45px}.other_list_itme label{margin-left:10px}.other_list_itme .link{margin-left:auto;color:#e0e0e0}.related{background:#F5F6F8;height:100vh;width:80vw;position:relative;display:flex;flex-direction:column}.related .addbox{margin-bottom:20px;width:calc(100% - 20px);text-align:center;display:flex;margin-top:auto}.related_tit{padding:25px 0 15px;background:#F5F6F8;font-size:16px;font-family:PingFang SC-Semibold,PingFang SC;font-weight:600;color:#333;text-align:center}.related .scrollHeight{height:100%}.related_list{line-height:1.6;max-height:calc(100% - 65px);overflow-y:hidden;position:relative}.related_list.iframe{height:calc(100% - 70px)}.related_list_itme{padding:10px;display:flex;align-items:center;background:#fff}.related_list_itme_tit{color:#333;font-size:15px;font-weight:600}.related_list_itme_left{font-weight:400;color:#999;font-size:12px}.related_list_itme_rigth{margin-left:auto}.related_list_itme_name{background:#849EB2;border-radius:4px;font-weight:600;color:#fff;font-size:14px;width:34px;height:34px;text-align:center;line-height:34px;margin-right:10px}.succ_tit{font-size:18px;font-weight:700}.convertSucc{text-align:center;padding-bottom:30px;color:#555}.convertSucc text{font-weight:700;margin:0 2px}
